{
  "info": {
    "_postman_id": "927bcbd4-b64e-4bcb-997b-3b8ac41c15de",
    "name": "Badminton Booking API",
    "description": "Collection all-in-one để quản lý và kiểm thử Badminton Booking API.\n\n- Chạy tuần tự folder 01-06 để kiểm thử luồng chính.\n- Token và ID tạo mới được tự động lưu vào collection variables.\n- Folder 07-09 chứa các thao tác upload, tài khoản và cleanup; chỉ chọn chạy khi cần.\n- Mỗi request kiểm tra đúng HTTP status; collection kiểm tra response envelope JSON dùng chung.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expectedStatus = Number(pm.variables.get('expectedStatus'));",
          "pm.test(`Status code is ${expectedStatus}`, function () {",
          "    pm.response.to.have.status(expectedStatus);",
          "});",
          "",
          "if (pm.response.code !== 204 && pm.response.code >= 200 && pm.response.code < 300) {",
          "    pm.test('Response is JSON with the standard API envelope', function () {",
          "        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "        const json = pm.response.json();",
          "        pm.expect(json).to.have.property('success', true);",
          "        pm.expect(json).to.have.property('message').that.is.a('string');",
          "        pm.expect(json).to.have.property('data');",
          "    });",
          "}"
        ]
      }
    }
  ],
