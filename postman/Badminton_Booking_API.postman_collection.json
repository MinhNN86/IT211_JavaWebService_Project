            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Court Updated\",\n  \"description\": \"Updated by Postman\",\n  \"address\": \"456 Test Street\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/manager/courts/{{courtId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('expectedStatus', '200');"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Time Slot",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('expectedStatus', '201');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json().data;",
                  "    pm.collectionVariables.set('timeSlotId', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"{{slotStart}}\",\n  \"endTime\": \"{{slotEnd}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/manager/courts/{{courtId}}/time-slots"
          }
        },
        {
          "name": "Bulk Create Time Slots",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('expectedStatus', '201');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json().data;",
                  "    pm.test('Creates eight 30-minute time slots', function () {",
                  "        pm.expect(data).to.be.an('array').with.lengthOf(8);",
                  "        pm.expect(data[0].startTime).to.eql('06:00');",
                  "        pm.expect(data[7].endTime).to.eql('10:00');",
                  "        pm.expect(data.every(slot => Number(slot.price) === 0)).to.be.true;",
                  "    });",
                  "    pm.collectionVariables.set('bulkPriceGroupOneIds', JSON.stringify(data.slice(0, 4).map(slot => slot.id)));",
                  "    pm.collectionVariables.set('bulkPriceGroupTwoIds', JSON.stringify(data.slice(4).map(slot => slot.id)));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"06:00\",\n  \"endTime\": \"10:00\",\n  \"durationMinutes\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/manager/courts/{{courtId}}/time-slots/bulk",
            "description": "Tạo nhanh 8 khung giờ, mỗi khung 30 phút, từ 06:00 đến 10:00. Có thể đổi durationMinutes thành 60."
          }
        },
        {
          "name": "Bulk Update Time Slot Prices",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('expectedStatus', '200');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json().data;",
                  "    pm.test('Updates two time slot price groups', function () {",
                  "        pm.expect(data).to.be.an('array').with.lengthOf(8);",
                  "        pm.expect(data.slice(0, 4).every(slot => Number(slot.price) === Number(pm.collectionVariables.get('defaultPrice')))).to.be.true;",
                  "        pm.expect(data.slice(4).every(slot => Number(slot.price) === Number(pm.collectionVariables.get('updatedPrice')))).to.be.true;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entries\": [\n    {\n      \"timeSlotIds\": {{bulkPriceGroupOneIds}},\n      \"price\": {{defaultPrice}}\n    },\n    {\n      \"timeSlotIds\": {{bulkPriceGroupTwoIds}},\n      \"price\": {{updatedPrice}}\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/manager/time-slots/prices",
            "description": "Cập nhật giá nhanh cho nhiều nhóm time slot. Mỗi nhóm có thể dùng một mức giá khác nhau."
          }
        },
        {
          "name": "Update Time Slot",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"{{slotStart}}\",\n  \"endTime\": \"{{slotEnd}}\",\n  \"price\": {{updatedPrice}},\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/manager/courts/{{courtId}}/time-slots/{{timeSlotId}}"
          },
          "event": [
