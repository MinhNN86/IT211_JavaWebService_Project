          "name": "Register Customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('expectedStatus', '201');",
                  "const suffix = Date.now();",
                  "pm.variables.set('registerUsername', `customer_${suffix}`);",
                  "pm.variables.set('registerEmail', `customer_${suffix}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json().data;",
                  "    pm.collectionVariables.set('registeredAccessToken', data.accessToken);",
                  "    pm.collectionVariables.set('registeredRefreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Customer\",\n  \"username\": \"{{registerUsername}}\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{defaultPassword}}\",\n  \"phone\": \"0900000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
