    {
      "name": "06 - Admin Users and Court Managers",
      "description": "Tạo một manager thứ hai, thêm vào sân đã tạo, kiểm tra danh sách quản lý, sau đó gỡ khỏi sân trước khi update/delete user.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminAccessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/users?keyword=&page=0&size=20&sort=id,asc"
          }
        },
        {
          "name": "Create User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.variables.set('newUsername', `postman_manager_${suffix}`);",
                  "pm.variables.set('newEmail', `postman_manager_${suffix}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('userId', data.id);",
                  "pm.collectionVariables.set('managerId', data.id);",
                  "pm.test('Created user has MANAGER role', function () {",
                  "    pm.expect(data.role).to.eql('MANAGER');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Manager\",\n  \"username\": \"{{newUsername}}\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"123456\",\n  \"phone\": \"0909999999\",\n  \"role\": \"MANAGER\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/users"
          }
        },
        {
          "name": "Add Manager to Court",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json().data;",
                  "pm.test('Added requested manager to court', function () {",
                  "    pm.expect(data.id).to.eql(pm.collectionVariables.get('managerId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/courts/{{courtId}}/managers/{{managerId}}",
            "description": "Admin thêm manager vừa tạo vào sân. Sân vẫn giữ manager ban đầu nên có nhiều người cùng quản lý."
          }
        },
        {
          "name": "List Court Managers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const managers = pm.response.json().data;",
                  "pm.test('Court contains newly assigned manager', function () {",
                  "    pm.expect(managers.map(manager => manager.id)).to.include(pm.collectionVariables.get('managerId'));",
                  "});",
                  "pm.test('Court has multiple managers', function () {",
                  "    pm.expect(managers.length).to.be.at.least(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/courts/{{courtId}}/managers"
          }
        },
        {
          "name": "Remove Manager from Court",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Manager removed from court', function () {",
                  "    pm.expect(pm.response.code).to.eql(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/courts/{{courtId}}/managers/{{managerId}}",
            "description": "Gỡ manager thử nghiệm khỏi sân để có thể tiếp tục update hoặc soft-delete user đó."
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/users/{{userId}}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Manager Updated\",\n  \"email\": \"updated_{{$timestamp}}@example.com\",\n  \"phone\": \"0908888888\",\n  \"status\": \"ACTIVE\",\n  \"role\": \"MANAGER\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/users/{{userId}}"
          }
        },
        {
          "name": "Delete User (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/users/{{userId}}"
          }
        }
      ]
