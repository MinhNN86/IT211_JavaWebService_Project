      "item": [
        {
          "name": "Create Court",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('courtId', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Court {{$timestamp}}\",\n  \"description\": \"Court created by Postman\",\n  \"address\": \"123 Test Street\",\n  \"pricePerHour\": 150000\n}"
            },
            "url": "{{baseUrl}}/api/v1/manager/courts"
          }
        },
        {
          "name": "Update Court",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Court Updated\",\n  \"description\": \"Updated by Postman\",\n  \"address\": \"456 Test Street\",\n  \"pricePerHour\": 180000,\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/manager/courts/{{courtId}}"
          }
        },
        {
          "name": "Create Time Slot",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const seconds = Math.floor(Date.now() / 1000) % 3600;",
                  "const minute = String(Math.floor(seconds / 60)).padStart(2, '0');",
                  "const second = String(seconds % 60).padStart(2, '0');",
                  "pm.collectionVariables.set('slotStart', `20:${minute}:${second}`);",
                  "pm.collectionVariables.set('slotEnd', `21:${minute}:${second}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('timeSlotId', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"{{slotStart}}\",\n  \"endTime\": \"{{slotEnd}}\",\n  \"price\": 50000\n}"
            },
            "url": "{{baseUrl}}/api/v1/manager/time-slots"
          }
        },
        {
          "name": "Update Time Slot",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"{{slotStart}}\",\n  \"endTime\": \"{{slotEnd}}\",\n  \"price\": 60000,\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/manager/time-slots/{{timeSlotId}}"
          }
        }
      ]
    },
