            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Customer Updated\",\n  \"email\": \"customer@demo.local\",\n  \"phone\": \"0912345678\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/profile"
          }
        },
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const date = new Date();",
                  "date.setDate(date.getDate() + 7);",
                  "pm.collectionVariables.set('bookingDate', date.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('bookingId', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courtId\": {{courtId}},\n  \"timeSlotIds\": [{{timeSlotId}}],\n  \"bookingDate\": \"{{bookingDate}}\",\n  \"note\": \"Booking created by Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/customer/bookings"
          }
        },
        {
          "name": "My Bookings",
          "request": {
            "method": "GET",
            "header": [],
