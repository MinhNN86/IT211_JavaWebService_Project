      "name": "07 - File Upload",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('runFileUploads') !== 'true') {",
              "    pm.execution.skipRequest();",
              "}"
            ]
          }
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{managerAccessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Upload and Attach Court Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('imageId', pm.response.json().data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "{{uploadFilePath}}"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "{{uploadFilePath2}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/manager/courts/{{courtId}}/images",
            "description": "Đặt `uploadFilePath`, `uploadFilePath2` hoặc chọn lại các file trong Postman trước khi gửi. Các ảnh được validate trước và lưu tuần tự."
          }
        },
        {
          "name": "Delete Court Image",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/manager/courts/images/{{imageId}}",
            "description": "Đặt `imageId` bằng UUID trả về khi upload ảnh hoặc lấy từ response chi tiết sân."
          }
        }
      ]
    },
    {
      "name": "08 - Manual Account Actions",
      "description": "Các request trong nhóm này thay đổi hoặc thu hồi thông tin đăng nhập. Nên chạy thủ công sau cùng.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{customerAccessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{defaultPassword}}\",\n  \"newPassword\": \"654321\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/change-password",
            "description": "Request này đổi mật khẩu tài khoản customer từ `123456` thành `654321`."
          }
        },
        {
          "name": "Logout Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{customerRefreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Request này xóa refresh token hiện tại của customer. Access token vẫn dùng được đến khi hết hạn."
          }
        }
      ]
    },
    {
      "name": "09 - Manual Cleanup",
      "description": "Xóa mềm dữ liệu setup. Chạy thủ công khi không cần dùng court/time slot đã tạo.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('runCleanup') !== 'true') {",
              "    pm.execution.skipRequest();",
              "}"
            ]
          }
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{managerAccessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Delete Court (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/manager/courts/{{courtId}}"
          }
        },
        {
          "name": "Delete Time Slot (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/manager/time-slots/{{timeSlotId}}"
          }
        }
      ]
    }
  ]
}
